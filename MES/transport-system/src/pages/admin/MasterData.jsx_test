                      <button onClick={() => handleDeleteRoute(r.id)} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"><Trash2 size={18}/></button>
                    </div>
                  </div>
                  {/* Show Stops */}
                  <div className="pl-14">
                    <p className="text-xs font-bold text-gray-500 mb-2">เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€เน€เธเธเน€เธโ€“ ({r.stops?.length || 0})</p>
                    {r.stops && r.stops.length > 0 ? (
                      <div className="flex flex-col gap-2">
                        {r.stops.map((stop, i) => (
