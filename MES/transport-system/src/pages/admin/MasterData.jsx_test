                            <div>
                              <p className="font-semibold">{stop.name}</p>
                              {stop.description && <p className="text-xs text-gray-500">{stop.description}</p>}
                            </div>
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p className="text-sm text-gray-400 italic">เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€</p>
                    )}
                  </div>
                </div>
              ))}
              {routes.length === 0 && <p className="col-span-full text-center py-8 text-gray-500">เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธโ€“</p>}
            </div>
          )}

          {/* List: Time Slots */}
          {activeTab === 'timeSlots' && (
