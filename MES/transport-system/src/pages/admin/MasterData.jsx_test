import { useState, useEffect } from 'react';
import { Database, Plus, Trash2, Bus, Route as RouteIcon, Clock, Save, X, BusFront, Pencil, Building2, UserCircle, MapPin, Car, Truck } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';

const MasterData = () => {
  const [activeTab, setActiveTab] = useState('fleet');
  
  const [fleet, setFleet] = useState([]);
  const [routes, setRoutes] = useState([]);
  const [timeSlots, setTimeSlots] = useState([]);
  const [departments, setDepartments] = useState([]);

  // States for Add/Edit Forms
  const [showAddForm, setShowAddForm] = useState(false);
  const [editingId, setEditingId] = useState(null);
  
  const [fleetForm, setFleetForm] = useState({ licensePlate: '', type: 'VAN', capacity: 12, driverEmpId: '', driverName: '', driverPhone: '' });
  const [routeForm, setRouteForm] = useState({ name: '', stops: [] });
  const [timeSlotForm, setTimeSlotForm] = useState({ name: '', time: '' });
  const [departmentForm, setDepartmentForm] = useState({ code: '', name: '' });

  // Load Data
  useEffect(() => {
    setFleet(JSON.parse(localStorage.getItem('fleet')) || []);
    setRoutes(JSON.parse(localStorage.getItem('routes')) || []);
    setTimeSlots(JSON.parse(localStorage.getItem('timeSlots')) || []);
    setDepartments(JSON.parse(localStorage.getItem('departments')) || []);
  }, []);

  // Save Data
  const saveData = (key, data) => {
    localStorage.setItem(key, JSON.stringify(data));
  };

  // -----------------------------------------------------
  // Fleet CRUD
  // -----------------------------------------------------
  const handleAddFleet = (e) => {
    e.preventDefault();
    let newData;
    if (editingId) {
      newData = fleet.map(f => f.id === editingId ? { ...f, ...fleetForm } : f);
    } else {
      newData = [...fleet, { id: `F-${Date.now()}`, ...fleetForm }];
    }
    setFleet(newData);
    saveData('fleet', newData);
    setShowAddForm(false);
    setEditingId(null);
    setFleetForm({ licensePlate: '', type: 'VAN', capacity: 12, driverEmpId: '', driverName: '', driverPhone: '' });
  };
  
  const handleEditFleet = (item) => {
    setFleetForm({ 
      licensePlate: item.licensePlate, 
      type: item.type, 
      capacity: item.capacity,
      driverEmpId: item.driverEmpId || '',
      driverName: item.driverName || '',
      driverPhone: item.driverPhone || ''
    });
    setEditingId(item.id);
    setShowAddForm(true);
  };
  const handleDeleteFleet = (id) => {
    if (confirm('เน€เธเธเน€เธเธ—เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธ…เน€เธยเน€เธเธเน€เธเธ’เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย?')) {
      const newData = fleet.filter(f => f.id !== id);
      setFleet(newData);
      saveData('fleet', newData);
    }
  };

  // -----------------------------------------------------
  // Routes CRUD
  // -----------------------------------------------------
  const handleAddRoute = (e) => {
    e.preventDefault();
    let newData;
    if (editingId) {
      newData = routes.map(r => r.id === editingId ? { ...r, ...routeForm } : r);
    } else {
      newData = [...routes, { id: `R-${Date.now()}`, ...routeForm }];
    }
    setRoutes(newData);
    saveData('routes', newData);
    setShowAddForm(false);
    setEditingId(null);
    setRouteForm({ name: '', stops: [] });
  };

  const handleEditRoute = (route) => {
    setRouteForm({ name: route.name, stops: route.stops || [] });
    setEditingId(route.id);
    setShowAddForm(true);
  };
  const handleDeleteRoute = (id) => {
    if (confirm('เน€เธเธเน€เธเธ—เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธ…เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธโ€“เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€เน€เธโ€”เน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธโ€เน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธเธ?')) {
      const newData = routes.filter(r => r.id !== id);
      setRoutes(newData);
      saveData('routes', newData);
    }
  };

  const addStopToForm = () => {
    setRouteForm({
      ...routeForm,
      stops: [...routeForm.stops, { id: `S-${Date.now()}-${Math.floor(Math.random()*1000)}`, name: '', description: '' }]
    });
  };

  const removeStopFromForm = (stopId) => {
    setRouteForm({
      ...routeForm,
      stops: routeForm.stops.filter(s => s.id !== stopId)
    });
  };

  const updateStopInForm = (stopId, field, value) => {
    setRouteForm({
      ...routeForm,
      stops: routeForm.stops.map(s => s.id === stopId ? { ...s, [field]: value } : s)
    });
