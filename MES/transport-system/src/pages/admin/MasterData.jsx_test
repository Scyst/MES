      {/* Header */}
      <div className="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400">
            <Database size={24} />
          </div>
          <div>
            <h2 className="text-xl font-bold text-gray-900 dark:text-white">เน€เธโ€ขเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธเธเน€เธเธ…เน€เธเธ‘เน€เธย (Master Data)</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400">เน€เธยเน€เธเธ‘เน€เธโ€เน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธโ€“ เน€เธเธเน€เธเธ’เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธเธเน€เธเธ’เน€เธโ€ขเน€เธเธเน€เธยเน€เธเธ’เน€เธย</p>
          </div>
        </div>
      </div>

      {/* Tabs */}
      <div className="flex overflow-x-auto hide-scrollbar gap-2 p-1 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 w-full md:w-fit">
        <button
          onClick={() => { setActiveTab('fleet'); setShowAddForm(false); setEditingId(null); }}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all whitespace-nowrap ${
            activeTab === 'fleet' ? 'bg-blue-600 text-white shadow-sm' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'
          }`}
        >
          <BusFront size={16} /> เน€เธเธเน€เธโ€“เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย ({fleet.length})
        </button>
        <button
          onClick={() => { setActiveTab('routes'); setShowAddForm(false); setEditingId(null); }}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all whitespace-nowrap ${
            activeTab === 'routes' ? 'bg-blue-600 text-white shadow-sm' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'
          }`}
        >
          <RouteIcon size={16} /> เน€เธโฌเน€เธเธเน€เธยเน€เธยเน€เธโ€”เน€เธเธ’เน€เธยเน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€ ({routes.length})
        </button>
        <button
          onClick={() => { setActiveTab('timeSlots'); setShowAddForm(false); setEditingId(null); }}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all whitespace-nowrap ${
            activeTab === 'timeSlots' ? 'bg-blue-600 text-white shadow-sm' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'
          }`}
        >
          <Clock size={16} /> เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’ ({timeSlots.length})
        </button>
        <button
          onClick={() => { setActiveTab('departments'); setShowAddForm(false); setEditingId(null); }}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-bold transition-all whitespace-nowrap ${
            activeTab === 'departments' ? 'bg-blue-600 text-white shadow-sm' : 'text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700'
          }`}
        >
          <Building2 size={16} /> เน€เธยเน€เธยเน€เธยเน€เธย/เน€เธยเน€เธยเน€เธเธ’เน€เธเธ ({departments.length})
        </button>
      </div>

      {/* Content Area */}
      <div className="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
        
        {/* Top Action Bar */}
        <div className="p-4 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center bg-gray-50/50 dark:bg-gray-900/20">
          <h3 className="font-bold text-gray-900 dark:text-white">
            {activeTab === 'fleet' && 'เน€เธเธเน€เธโ€“เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย'}
            {activeTab === 'routes' && 'เน€เธโฌเน€เธเธเน€เธยเน€เธยเน€เธโ€”เน€เธเธ’เน€เธยเน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€'}
            {activeTab === 'timeSlots' && 'เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’ (Time Slots)'}
            {activeTab === 'departments' && 'เน€เธยเน€เธยเน€เธเธ’เน€เธเธ / เน€เธยเน€เธยเน€เธยเน€เธย (Business Units)'}
          </h3>
          <button
            onClick={() => {
              setEditingId(null);
              setFleetForm({ licensePlate: '', type: 'VAN', capacity: 12, driverEmpId: '', driverName: '', driverPhone: '' });
              setRouteForm({ name: '', stops: [] });
              setTimeSlotForm({ name: '', time: '' });
              setDepartmentForm({ code: '', name: '' });
              setShowAddForm(true);
            }}
            className="flex items-center gap-2 px-4 py-2 text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors"
          >
            <Plus size={16}/> เน€เธโฌเน€เธยเน€เธเธ”เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…
          </button>
        </div>



        {/* Data Lists */}
        <div className="p-4">
          
          {/* List: Fleet */}
          {activeTab === 'fleet' && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {fleet.map(f => (
                <div key={f.id} className="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/30 gap-4">
                  <div className="flex items-start gap-4">
                    <div className={`w-12 h-12 flex-shrink-0 rounded-xl flex items-center justify-center font-bold ${f.type === 'BUS' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-400' : f.type === 'CAR' ? 'bg-purple-100 text-purple-700 dark:bg-purple-900/50 dark:text-purple-400' : f.type === 'SONGTHAEW' ? 'bg-orange-100 text-orange-700 dark:bg-orange-900/50 dark:text-orange-400' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-400'}`}>
                      {f.type === 'BUS' ? <Bus size={24}/> : f.type === 'CAR' ? <Car size={24}/> : f.type === 'SONGTHAEW' ? <Truck size={24}/> : <BusFront size={24}/>}
                    </div>
                    <div className="grid sm:grid-cols-2 gap-x-8 gap-y-1">
                      <div>
                        <p className="text-[10px] font-bold text-gray-500 uppercase">เน€เธเธเน€เธเธ’เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ</p>
                        <p className="font-bold text-gray-900 dark:text-white text-sm">{f.licensePlate}</p>
                        <p className="text-xs text-gray-500 dark:text-gray-400">{f.type === 'BUS' ? 'เน€เธเธเน€เธโ€“เน€เธยเน€เธเธ‘เน€เธเธ' : 'เน€เธเธเน€เธโ€“เน€เธโ€ขเน€เธเธเน€เธย'} เนโฌเธ {f.capacity} เน€เธโ€”เน€เธเธ•เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธย</p>
                      </div>
                      <div>
                        <p className="text-[10px] font-bold text-gray-500 uppercase">เน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ“เน€เธเธเน€เธโ€“</p>
                        <p className="font-bold text-gray-900 dark:text-white text-sm">{f.driverName || '-'}</p>
                        <p className="text-xs text-gray-500 dark:text-gray-400">{f.driverEmpId ? `${f.driverEmpId} เนโฌเธ ` : ''}{f.driverPhone || '-'}</p>
                      </div>
                    </div>
                  </div>
                  <div className="flex items-center gap-1 self-end sm:self-center">
                    <button onClick={() => handleEditFleet(f)} className="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"><Pencil size={18}/></button>
                    <button onClick={() => handleDeleteFleet(f.id)} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"><Trash2 size={18}/></button>
                  </div>
                </div>
              ))}
              {fleet.length === 0 && <p className="col-span-full text-center py-8 text-gray-500">เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธเธเน€เธโ€“เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย</p>}
            </div>
          )}

          {/* List: Routes */}
          {activeTab === 'routes' && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
