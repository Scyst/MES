                <div key={d.id} className="flex items-center justify-between p-4 rounded-xl border border-gray-100 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/30">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 rounded-lg bg-pink-100 text-pink-700 dark:bg-pink-900/50 dark:text-pink-400 flex items-center justify-center">
                      <Building2 size={20}/>
                    </div>
                    <div>
                      <p className="font-bold text-gray-900 dark:text-white">{d.name}</p>
                      <p className="text-xs font-mono font-bold text-gray-500 dark:text-gray-400">{d.code}</p>
                    </div>
                  </div>
                  <div className="flex items-center gap-1">
                    <button onClick={() => handleEditDepartment(d)} className="p-2 text-gray-400 hover:text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"><Pencil size={18}/></button>
                    <button onClick={() => handleDeleteDepartment(d.id)} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"><Trash2 size={18}/></button>
                  </div>
                </div>
              ))}
              {departments.length === 0 && <p className="col-span-full text-center py-8 text-gray-500">เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธยเน€เธยเน€เธยเน€เธย</p>}
            </div>
          )}

        </div>
      </div>

      {/* Add / Edit Modal */}
      <AnimatePresence>
      {showAddForm && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">`n          <motion.div `n            initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}`n            className="absolute inset-0 bg-black/50 backdrop-blur-sm"`n            onClick={() => {`n              setShowAddForm(false);`n              setEditingId(null);`n            }}`n          ></motion.div>
          <motion.div `n            initial={{ scale: 0.95, opacity: 0, y: 20 }} `n            animate={{ scale: 1, opacity: 1, y: 0 }} `n            exit={{ scale: 0.95, opacity: 0, y: 20 }}`n            className="bg-white dark:bg-gray-800 rounded-2xl p-6 max-w-3xl w-full shadow-2xl max-h-[90vh] overflow-y-auto relative z-10">`n
            <div className="flex justify-between items-center mb-6">
              <h3 className="text-xl font-bold text-gray-900 dark:text-white">
                {editingId ? 'เน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…' : 'เน€เธโฌเน€เธยเน€เธเธ”เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธยเน€เธเธเน€เธเธเน€เธย'}
              </h3>
              <button
                onClick={() => {
                  setShowAddForm(false);
                  setEditingId(null);
                  setFleetForm({ licensePlate: '', type: 'VAN', capacity: 12, driverEmpId: '', driverName: '', driverPhone: '' });
                  setRouteForm({ name: '', stops: [] });
                  setTimeSlotForm({ name: '', time: '' });
                  setDepartmentForm({ code: '', name: '' });
                }}
                className="p-2 text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full transition-colors"
              >
                <X size={20} />
              </button>
            </div>

            {/* Form: Fleet */}
            {activeTab === 'fleet' && (
              <form onSubmit={handleAddFleet} className="flex flex-col gap-4">
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div className="flex-1">
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธโ€”เน€เธเธเน€เธโฌเน€เธยเน€เธเธ•เน€เธเธเน€เธยเน€เธเธเน€เธโ€“</label>
                    <input type="text" required placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย 10-1234 เน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธย" value={fleetForm.licensePlate} onChange={e => setFleetForm({...fleetForm, licensePlate: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธเน€เธเธเน€เธโฌเน€เธย เน€เธโ€”</label>
                    <select value={fleetForm.type} onChange={e => {
                        const newType = e.target.value;
                        let newCap = 12;
                        if(newType === 'BUS') newCap = 40;
                        if(newType === 'CAR') newCap = 4;
                        if(newType === 'SONGTHAEW') newCap = 14;
                        setFleetForm({...fleetForm, type: newType, capacity: newCap});
                      }} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500">
                      <option value="VAN">เธฃเธ–เธ•เธนเน</option>
                      <option value="BUS">เธฃเธ–เธเธฑเธช</option>
                      <option value="SONGTHAEW">เธฃเธ–เธชเธญเธเนเธ–เธง</option>
                      <option value="CAR">เธฃเธ–เธชเนเธงเธเธเธธเธเธเธฅ</option>
                    </select>
                  </div>
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ</label>
                    <input type="number" required min="1" value={fleetForm.capacity} onChange={e => setFleetForm({...fleetForm, capacity: parseInt(e.target.value)})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                </div>
                
                <h4 className="font-bold text-gray-900 dark:text-white mt-4 border-b border-gray-200 dark:border-gray-700 pb-2">เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ“เน€เธเธเน€เธโ€“</h4>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธเธเน€เธเธเน€เธเธ‘เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย</label>
                    <input type="text" placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย DRV001" value={fleetForm.driverEmpId} onChange={e => setFleetForm({...fleetForm, driverEmpId: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                  <div className="flex-1">
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธย</label>
                    <input type="text" placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย เน€เธเธเน€เธเธเน€เธยเน€เธเธ’เน€เธเธ เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€เน€เธเธ•" value={fleetForm.driverName} onChange={e => setFleetForm({...fleetForm, driverName: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธโ€”เน€เธเธ</label>
                    <input type="tel" placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย 081-234-5678" value={fleetForm.driverPhone} onChange={e => setFleetForm({...fleetForm, driverPhone: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                </div>
                
                <div className="flex justify-end mt-4">
                  <button type="submit" className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors flex items-center gap-2"><Save size={18}/> เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ–เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…</button>
                </div>
              </form>
            )}

            {/* Form: Route */}
            {activeTab === 'routes' && (
              <form onSubmit={handleAddRoute} className="flex flex-col gap-4">
                <div>
                  <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธโ€“</label>
                  <input type="text" required placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย เน€เธเธเน€เธเธ’เน€เธเธ CK" value={routeForm.name} onChange={e => setRouteForm({...routeForm, name: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                </div>
                <div className="space-y-3 mt-4">
                  <div className="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 pb-2">
                    <label className="block text-base font-bold text-gray-700 dark:text-gray-300">เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธโ€“</label>
                    <button type="button" onClick={addStopToForm} className="text-sm px-3 py-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-lg font-bold flex items-center gap-1 transition-colors"><Plus size={14}/> เน€เธโฌเน€เธยเน€เธเธ”เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€</button>
                  </div>
                  {routeForm.stops.map((stop, index) => (
                    <div key={stop.id} className="flex items-start gap-3 bg-gray-50 dark:bg-gray-900/50 p-4 rounded-xl border border-gray-200 dark:border-gray-700">
                      <div className="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm flex-shrink-0 mt-1">{index + 1}</div>
                      <div className="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                          <label className="block text-[11px] font-bold text-gray-500 uppercase mb-1">เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€</label>
                          <input type="text" required value={stop.name} onChange={e => updateStopInForm(stop.id, 'name', e.target.value)} className="w-full px-3 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย เน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธโฌเน€เธเธเน€เธยเน€เธย" />
                        </div>
                        <div>
                          <label className="block text-[11px] font-bold text-gray-500 uppercase mb-1">เน€เธเธเน€เธเธ’เน€เธเธเน€เธเธ…เน€เธเธเน€เธโฌเน€เธเธเน€เธเธ•เน€เธเธเน€เธโ€ / เน€เธยเน€เธเธเน€เธโ€เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธโ€ข</label>
                          <input type="text" value={stop.description} onChange={e => updateStopInForm(stop.id, 'description', e.target.value)} className="w-full px-3 py-2 text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" placeholder="เน€เธเธเน€เธเธ’เน€เธเธ…เน€เธเธ’เน€เธยเน€เธเธ‘เน€เธย" />
                        </div>
                      </div>
                      <button type="button" onClick={() => removeStopFromForm(stop.id)} className="p-2 text-red-500 hover:bg-red-50 rounded-lg mt-5"><Trash2 size={20}/></button>
                    </div>
                  ))}
                  {routeForm.stops.length === 0 && <p className="text-sm text-gray-500 italic text-center py-4">เน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€ (เน€เธเธเน€เธเธ’เน€เธเธเน€เธเธ’เน€เธเธเน€เธโ€“เน€เธยเน€เธโ€เน€เธยเน€เธเธเน€เธยเน€เธเธ "เน€เธโฌเน€เธยเน€เธเธ”เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธโ€" เน€เธยเน€เธโ€เน€เธย)</p>}
                </div>
                <div className="flex justify-end mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                  <button type="submit" className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors flex items-center gap-2"><Save size={18}/> เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ–เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…</button>
                </div>
              </form>
            )}

            {/* Form: Time Slots */}
            {activeTab === 'timeSlots' && (
              <form onSubmit={handleAddTimeSlot} className="flex flex-col gap-4">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโฌเน€เธเธเน€เธเธ•เน€เธเธเน€เธยเน€เธยเน€เธเธ (Shift)</label>
                    <input type="text" required placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย เน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธยเน€เธเธ’, เน€เธยเน€เธเธเน€เธโ€เน€เธเธ–เน€เธย" value={timeSlotForm.name} onChange={e => setTimeSlotForm({...timeSlotForm, name: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธโฌเน€เธโ€เน€เธเธ”เน€เธยเน€เธเธเน€เธโ€“ (HH:mm)</label>
                    <input type="time" required value={timeSlotForm.time} onChange={e => setTimeSlotForm({...timeSlotForm, time: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                </div>
                <div className="flex justify-end mt-4">
                  <button type="submit" className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors flex items-center gap-2"><Save size={18}/> เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ–เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…</button>
                </div>
              </form>
            )}

            {/* Form: Departments */}
            {activeTab === 'departments' && (
              <form onSubmit={handleAddDepartment} className="flex flex-col gap-4">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธเธเน€เธเธเน€เธเธ‘เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธย/เน€เธยเน€เธยเน€เธเธ’เน€เธเธ</label>
                    <input type="text" required placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย PROD1" value={departmentForm.code} onChange={e => setDepartmentForm({...departmentForm, code: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                  <div>
                    <label className="block text-sm font-bold text-gray-700 dark:text-gray-300 mb-1">เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธย/เน€เธยเน€เธยเน€เธเธ’เน€เธเธ</label>
                    <input type="text" required placeholder="เน€เธโฌเน€เธยเน€เธยเน€เธย Production 1" value={departmentForm.name} onChange={e => setDepartmentForm({...departmentForm, name: e.target.value})} className="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-600 rounded-lg outline-none focus:border-blue-500" />
                  </div>
                </div>
                <div className="flex justify-end mt-4">
                  <button type="submit" className="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors flex items-center gap-2"><Save size={18}/> เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ–เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ…</button>
                </div>
              </form>
            )}
          </motion.div>
        </div>
      )}
      </AnimatePresence>
    </div>
  );
};

export default MasterData;


